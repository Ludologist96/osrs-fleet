[Unit]
Description=OSRS fleet - browser access to the slot screens (noVNC bridge on port 6080)
After=network.target

[Service]
ExecStart=/opt/osrs/venv/bin/websockify --token-plugin TokenFile --token-source /etc/osrs/vnc-tokens 127.0.0.1:6080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
