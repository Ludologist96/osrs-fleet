#!/usr/bin/env bash
# Runs one component of one fleet slot. Called by the systemd units:
#   slot <xvfb|wm|vnc|client|app> <N>
set -euo pipefail

CONF=/etc/osrs/fleet.conf
[ -f "$CONF" ] && source "$CONF"
RESOLUTION=${RESOLUTION:-1280x800}
APP_DIR=${APP_DIR:-/opt/osrs/app}

comp=${1:?component}
n=${2:?slot number}
export DISPLAY=":$n"

wait_display() {
    for _ in $(seq 1 100); do
        xdpyinfo -display ":$n" >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    echo "display :$n did not come up" >&2
    exit 1
}

case "$comp" in
    xvfb)
        # -ac: any local user may connect (the dashboard reads every screen).
        # -nolisten tcp: nothing is reachable from the network.
        rm -f "/tmp/.X${n}-lock"
        exec Xvfb ":$n" -screen 0 "${RESOLUTION}x24" -nolisten tcp -ac -dpi 96
        ;;
    wm)
        wait_display
        # No key auto-repeat: a held key must never turn into repeated presses.
        xset r off || true
        exec openbox
        ;;
    vnc)
        wait_display
        exec x11vnc -display ":$n" -rfbport $((5900 + n)) -localhost \
            -forever -shared -nopw -quiet -noxdamage
        ;;
    client)
        wait_display
        cd "$HOME"
        # Slot with its own proxy: never start RuneLite before the kill switch and
        # the slot's proxy are up (otherwise it could connect from the home IP).
        if [ -e "/etc/osrs/proxy/slot$n.on" ]; then
            for _ in $(seq 1 120); do
                [ -e /run/osrs/proxy-rules.ok ] && \
                    (exec 3<>"/dev/tcp/127.0.0.1/$((12000 + n))") 2>/dev/null && break
                sleep 1
            done
            [ -e /run/osrs/proxy-rules.ok ] || { echo "proxy rules not in place - not starting" >&2; exit 1; }
        fi
        # Start RuneLites one at a time, a little apart. When all 8 launchers
        # download the client at once, repo.runelite.net answers HTTP 429
        # (rate limited) and RuneLite stops with "fatal error".
        lock=/run/osrs/runelite-start.lock
        if [ -w "$lock" ] || [ -w "$(dirname "$lock")" ]; then
            flock "$lock" sleep "${CLIENT_START_GAP:-20}"
        else
            sleep $(( (n - 1) * ${CLIENT_START_GAP:-20} ))
        fi
        # Java options for the game itself (not the launcher), passed with -J. They come
        # after RuneLite's own (-Xmx768m ...), so ours win. Fewer malloc arenas = less RAM.
        export MALLOC_ARENA_MAX=2
        jargs=()
        cjvm=${CLIENT_JVM_ARGS--Xmx512m -XX:+UseSerialGC -XX:ReservedCodeCacheSize=64m}
        for a in $cjvm; do
            jargs+=("-J$a")
        done
        # shellcheck disable=SC2086
        java ${JAVA_OPTS:-} -jar /opt/osrs/runelite/RuneLite.jar "${jargs[@]}" || true
        # The launcher starts the game in a second Java process and exits.
        # Stay alive while the game runs: when this script ends, systemd stops
        # everything it started, the game included, and restarts it in a loop.
        sleep 5
        while pgrep -u "$(id -u)" -f 'net\.runelite\.client\.RuneLite' >/dev/null; do
            sleep 5
        done
        ;;
    app)
        wait_display
        cd "$APP_DIR"
        export OSRS_SLOT="$n"
        export OSRS_CV_DEBUG="${CV_DEBUG:-0}"          # CV debug viewer off unless CV_DEBUG=1
        export OSRS_CACHE_DIR=/var/lib/osrs/cache      # shared item icon cache
        export MALLOC_ARENA_MAX=2                      # fewer malloc arenas = less RAM
        exec /opt/osrs/venv/bin/python main.py --port $((8010 + n))
        ;;
    *)
        echo "unknown component: $comp" >&2
        exit 2
        ;;
esac
