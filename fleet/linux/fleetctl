#!/usr/bin/env bash
# Manage the OSRS fleet slots.  Run `fleetctl help`.
set -euo pipefail

source /etc/osrs/fleet.conf
SLOTS=${SLOTS:-8}
APP_DIR=${APP_DIR:-/opt/osrs/app}
COMPONENTS="xvfb wm vnc client app"

need_root() {
    if [ "$(id -u)" -ne 0 ]; then exec sudo "$0" "$@"; fi
}

slots_of() {   # "all" | "3" | "2,5,7" -> list
    if [ "${1:-all}" = all ]; then seq 1 "$SLOTS"; else tr ',' '\n' <<<"$1"; fi
}

unit_of() {   # slot component -> unit
    if [ -z "${2:-}" ] || [ "$2" = all ]; then echo "osrs-slot@$1.target"
    else echo "osrs-$2@$1.service"; fi
}

cmd_status() {
    printf '%-5s %-8s %-8s %-8s %-8s %-8s  %s\n' SLOT SCREEN WM VNC RUNELITE APP "WINDOW"
    for n in $(seq 1 "$SLOTS"); do
        row=()
        for c in $COMPONENTS; do
            row+=("$(systemctl is-active "osrs-$c@$n.service" 2>/dev/null || true)")
        done
        title=$(DISPLAY=":$n" xdotool search --name '^RuneLite' getwindowname 2>/dev/null | head -1 || true)
        printf '%-5s %-8s %-8s %-8s %-8s %-8s  %s\n' "$n" "${row[@]}" "${title:--}"
    done
    echo
    echo "Dashboard: http://localhost:${DASHBOARD_PORT:-8000}   Bot UI: http://localhost:801N   VNC: localhost:590N"
}

cmd_unit_action() {   # action slots [component]
    need_root "$@"
    local action=$1 which=${2:-all} comp=${3:-}
    for n in $(slots_of "$which"); do
        systemctl "$action" "$(unit_of "$n" "$comp")"
        echo "$action slot $n ${comp:-(all parts)}"
    done
}

cmd_update() {
    need_root update
    src=$(cat /etc/osrs/source_dir)
    echo "Copying code from $src ..."
    rsync -a --delete \
        --exclude '.git/' --exclude '.venv/' --exclude '__pycache__/' \
        --exclude 'node_modules/' --exclude '*.log' \
        --exclude 'data/configs/slot*/' \
        "$src/" "$APP_DIR/"
    chown -R root:osrs "$APP_DIR"; chmod -R g+rwX "$APP_DIR"
    install -m 755 "$src/fleet/linux/slot" /opt/osrs/bin/slot
    install -m 755 "$src/fleet/linux/fleetctl" /opt/osrs/bin/fleetctl
    new_sha=$(sha256sum "$APP_DIR/requirements.txt" | cut -d' ' -f1)
    if [ "$new_sha" != "$(cat /opt/osrs/.requirements.sha 2>/dev/null)" ]; then
        echo "requirements.txt changed - updating Python packages"
        /opt/osrs/venv/bin/pip install -q -r "$APP_DIR/requirements.txt" python-xlib
        echo "$new_sha" > /opt/osrs/.requirements.sha
    fi
    changed=0
    for f in "$src"/fleet/linux/systemd/*; do
        cmp -s "$f" "/etc/systemd/system/$(basename "$f")" || changed=1
    done
    if [ "$changed" = 1 ]; then
        install -m 644 "$src"/fleet/linux/systemd/* /etc/systemd/system/
        systemctl daemon-reload
    fi
    for n in $(seq 1 "$SLOTS"); do echo "slot$n: 127.0.0.1:$((5900 + n))"; done > /etc/osrs/vnc-tokens
    systemctl enable osrs-websockify.service >/dev/null 2>&1 || true
    systemctl restart osrs-websockify.service || true
    echo "Restarting bot apps and dashboard (RuneLite clients keep running)"
    for n in $(seq 1 "$SLOTS"); do systemctl restart "osrs-app@$n.service"; done
    systemctl enable osrs-telegram.service >/dev/null 2>&1 || true
    systemctl restart osrs-telegram.service || true
    systemctl restart osrs-dashboard.service
    echo "Updated."
}

cmd_creds() {   # slot [file]
    need_root creds "$@"
    local n=${1:?slot number} file=${2:-}
    if [ -z "$file" ]; then
        file=$(ls -t /mnt/c/Users/*/.runelite/credentials.properties 2>/dev/null | head -1 || true)
    fi
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo "No credentials.properties found. Give the path: fleetctl creds $n /mnt/c/Users/<you>/.runelite/credentials.properties" >&2
        exit 1
    fi
    install -d -o "bot$n" -g "bot$n" "/home/bot$n/.runelite"
    install -m 600 -o "bot$n" -g "bot$n" "$file" "/home/bot$n/.runelite/credentials.properties"
    echo "Copied $file -> slot $n. Restarting its RuneLite."
    systemctl restart "osrs-client@$n.service"
}

cmd_copy_settings() {   # from to|all
    need_root copy-settings "$@"
    local from=${1:?from slot} to=${2:?to slot or all}
    local src="/home/bot$from/.runelite"
    [ -d "$src" ] || { echo "slot $from has no RuneLite settings yet" >&2; exit 1; }
    for n in $(slots_of "$to"); do
        [ "$n" = "$from" ] && continue
        systemctl stop "osrs-client@$n.service"
        install -d -o "bot$n" -g "bot$n" "/home/bot$n/.runelite"
        rsync -a --exclude 'credentials.properties' --exclude 'cache/' \
              --exclude 'logs/' --exclude 'jagexcache/' --exclude 'repository2/' \
              "$src/" "/home/bot$n/.runelite/"
        chown -R "bot$n:bot$n" "/home/bot$n/.runelite"
        systemctl start "osrs-client@$n.service"
        echo "RuneLite settings: slot $from -> slot $n"
    done
}

cmd_slots() {   # N : run N slots (creates users, copies slot 1's RuneLite + bot settings)
    need_root slots "$@"
    local want=${1:?number of slots} old=$SLOTS
    [[ "$want" =~ ^[0-9]+$ ]] && [ "$want" -ge 1 ] && [ "$want" -le 30 ] || { echo "give 1..30" >&2; exit 1; }
    sed -i "s/^SLOTS=.*/SLOTS=$want/" /etc/osrs/fleet.conf
    getent group osrs >/dev/null || groupadd osrs
    for n in $(seq 1 "$want"); do
        if ! id "bot$n" >/dev/null 2>&1; then
            useradd -m -s /bin/bash -G osrs "bot$n"
            echo "created user bot$n"
        fi
        # a new slot gets slot 1's RuneLite plugins/settings (not its login) ...
        if [ "$n" -gt 1 ] && [ ! -d "/home/bot$n/.runelite/profiles2" ] && [ -d /home/bot1/.runelite ]; then
            install -d -o "bot$n" -g "bot$n" "/home/bot$n/.runelite"
            rsync -a --exclude 'credentials.properties' --exclude 'cache/' \
                  --exclude 'logs/' --exclude 'jagexcache/' --exclude 'repository2/' \
                  /home/bot1/.runelite/ "/home/bot$n/.runelite/"
            chown -R "bot$n:bot$n" "/home/bot$n/.runelite"
            echo "slot $n: RuneLite settings copied from slot 1"
        fi
        # ... and slot 1's saved bot settings
        if [ ! -d "$APP_DIR/data/configs/slot$n" ] && [ -d "$APP_DIR/data/configs/slot1" ]; then
            cp -a "$APP_DIR/data/configs/slot1" "$APP_DIR/data/configs/slot$n"
            chown -R root:osrs "$APP_DIR/data/configs/slot$n"; chmod -R g+rwX "$APP_DIR/data/configs/slot$n"
            echo "slot $n: bot settings copied from slot 1"
        fi
    done
    for n in $(seq 1 "$want"); do echo "slot$n: 127.0.0.1:$((5900 + n))"; done > /etc/osrs/vnc-tokens
    # slots above the new count: stop them (their users and settings stay)
    for n in $(seq $((want + 1)) "$old"); do
        systemctl disable --now "osrs-slot@$n.target" >/dev/null 2>&1 || true
        echo "stopped slot $n"
    done
    for n in $(seq 1 "$want"); do
        systemctl enable "osrs-slot@$n.target" >/dev/null 2>&1
        systemctl start "osrs-slot@$n.target"
    done
    systemctl restart osrs-websockify.service || true
    systemctl restart osrs-telegram.service || true
    echo "Now $want slots."
    systemctl restart osrs-dashboard.service
}

cmd_wslconfig() {   # MEMORY_GB PROCESSORS : write Windows' .wslconfig (takes effect after the VM restarts)
    need_root wslconfig "$@"
    local mem=${1:?memory GB} cpu=${2:?processors}
    local f
    f=$(ls /mnt/c/Users/*/.wslconfig 2>/dev/null | head -1 || true)
    [ -n "$f" ] || { echo "no .wslconfig found under /mnt/c/Users" >&2; exit 1; }
    cp "$f" "$f.bak"
    if grep -q '^memory=' "$f"; then sed -i "s/^memory=.*/memory=${mem}GB/" "$f"; else sed -i "/^\[wsl2\]/a memory=${mem}GB" "$f"; fi
    if grep -q '^processors=' "$f"; then sed -i "s/^processors=.*/processors=${cpu}/" "$f"; else sed -i "/^\[wsl2\]/a processors=${cpu}" "$f"; fi
    echo "Wrote $f (old one: .wslconfig.bak):"; cat "$f"
    echo "Restart the VM to use it: double-click fleet\windows\Restart fleet VM.bat (or restart Windows)."
}

cmd_restart_vm() {   # restart the whole WSL VM from inside it (new .wslconfig takes effect)
    need_root restart-vm
    local ps=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
    [ -x "$ps" ] || { echo "Windows PowerShell not reachable (WSL interop off?)" >&2; exit 1; }
    # A hidden Windows process, independent of this VM: waits, shuts WSL down, starts it again
    # through the "OSRS Fleet" logon task (the same one Windows runs at login).
    "$ps" -NoProfile -Command "Start-Process -WindowStyle Hidden -FilePath powershell.exe -ArgumentList '-NoProfile','-Command','Start-Sleep 5; wsl.exe --shutdown; Start-Sleep 10; Start-ScheduledTask -TaskName \"OSRS Fleet\"'"
    echo "VM restarts in ~5 s and is back ~20 s later."
}

cmd_logs() {   # slot [component]
    local n=${1:?slot number} comp=${2:-app}
    exec journalctl -u "osrs-$comp@$n.service" -n 200 -f
}

cmd_help() {
    cat <<EOF
fleetctl - manage the OSRS fleet ($SLOTS slots)

  fleetctl status                       what is running in every slot
  fleetctl start|stop|restart <N|all|2,5> [part]
                                        part = xvfb | wm | vnc | client | app
                                        (no part = the whole slot)
  fleetctl update                       copy new code from Windows and restart bot apps,
                                        dashboard and Telegram bot
  fleetctl creds <N> [file]             give slot N the Jagex login saved by RuneLite
                                        on Windows (credentials.properties)
  fleetctl copy-settings <from> <to|all>
                                        copy RuneLite plugins/settings between slots
  fleetctl logs <N> [part]              follow a slot's log (default part: app)
  fleetctl slots <N>                    run N slots (new ones get slot 1's settings)
  fleetctl wslconfig <GB> <threads>     set the VM's RAM/CPU in Windows' .wslconfig
  fleetctl restart-vm                   restart the VM (uses the new .wslconfig)

Slot N:  bot web UI http://localhost:801N   VNC localhost:590N   screen :N
EOF
}

case "${1:-help}" in
    status) cmd_status ;;
    start|stop|restart) a=$1; shift; cmd_unit_action "$a" "$@" ;;
    update) cmd_update ;;
    creds) shift; cmd_creds "$@" ;;
    copy-settings) shift; cmd_copy_settings "$@" ;;
    logs) shift; cmd_logs "$@" ;;
    slots) shift; cmd_slots "$@" ;;
    wslconfig) shift; cmd_wslconfig "$@" ;;
    restart-vm) cmd_restart_vm ;;
    *) cmd_help ;;
esac
